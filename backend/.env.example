# ============================================================
# 环境变量示例文件
# 使用方法：复制本文件为 .env，然后填入你自己的真实值
#   cp .env.example .env
# 注意：.env 里含密钥，不要提交到 git（已在 .gitignore 中排除）
# ============================================================

# ---------- 阿里云百炼 DashScope ----------
# 在 https://bailian.console.aliyun.com/ 控制台创建 API Key
DASHSCOPE_API_KEY=sk-在这里填入你的百炼APIKey

# 百炼的 OpenAI 兼容端点（北京地域）。新加坡地域改成 dashscope-intl.aliyuncs.com
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------- 模型选择 ----------
# 对话模型：qwen-plus 效果与价格平衡；想省钱可换 qwen-turbo
LLM_MODEL=qwen-plus
# 向量模型：text-embedding-v3 支持 1024/768/512 维
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
# 重排模型：对召回结果做精排，提升准确率
RERANK_MODEL=gte-rerank-v2

# ---------- 安全 ----------
# 生产环境务必换成随机长字符串！可用下面命令生成：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=请务必改成随机长字符串

# ---------- 管理员种子账号（首次启动自动创建）----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456

# ---------- 调试 ----------
# 生产环境设为 false（会关闭接口文档和详细报错）
DEBUG=true


# ============================================================
#  以下是调优参数，全都有合理的默认值。
#  不改也能正常跑，想让系统达到最佳效果时再来调。
#  每一条改了会有什么影响，注释里都写了实测结论。
# ============================================================

# ---------- 文件上传 ----------
# 单个文件大小上限（MB）
MAX_UPLOAD_SIZE_MB=50
# 允许的文件类型，逗号分隔
ALLOWED_EXTENSIONS=.pdf,.docx,.xlsx,.txt,.md
# 同时处理的文档数量上限。
# **不要调大**：每份文档处理时要独占一个数据库连接且整个过程中不释放，
# 一次提交太多会把连接池打满，表现为"文档卡在处理中"且没有任何报错。
DOCUMENT_PROCESS_CONCURRENCY=2

# ---------- 数据库连接池 ----------
# SQLite 是文件锁模型，连接开太多反而互相等锁，主要靠上面的并发限制
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# 取不到连接时的等待秒数。设短一点让它快速失败，问题才容易被发现
DB_POOL_TIMEOUT=10

# ---------- 文本分块 ----------
# 每个分块的字符数。中文一个字的信息量比英文单词大，500 左右比较合适
CHUNK_SIZE=500
# 相邻分块的重叠字符数，避免一句话被切在边界上导致两边都不完整
CHUNK_OVERLAP=80
# 是否给每个分块补上来源标题前缀（【商品名 · 小节名】）。
# **这是收益最大的一项优化**，关掉可以复现优化前的效果做对比实验。
CHUNK_CONTEXT_ENABLED=true

# ---------- 检索 ----------
# 检索策略：vector（纯向量）/ keyword（纯关键词）/ hybrid（混合，推荐）
RETRIEVAL_MODE=hybrid
# 每路召回的候选数量
RETRIEVE_TOP_K=20
# 精排后最终送给大模型的分块数
RERANK_TOP_N=5
# 是否启用重排。注意本项目实测在 54 个分块的语料上重排没有提升指标，
# 详细结论见 README 的「优化效果」一节
RERANK_ENABLED=true
# 重排分数低于此值就丢弃。默认 0 表示不过滤——
# gte-rerank-v2 的分数区间实测只有 0.19/0.14/0.006 这种量级，
# 拍脑袋设 0.5 会把所有结果都过滤光
RERANK_SCORE_THRESHOLD=0.0
# 向量检索的相似度下限。**目前这个值实际上什么都过滤不掉**
# （无关问题的相似度也有 0.39），详细的阈值标定待做
SIMILARITY_THRESHOLD=0.15

# ---------- RRF 融合（混合检索时生效）----------
# 融合公式 score = Σ 权重/(K + 排名) 里的平滑常数
RRF_K=60
# 两路检索的权重。0.7/0.3 是实验测出来的最优配比，
# 等权配置的 Recall@1 会从 66.7% 掉到 60%
RRF_VECTOR_WEIGHT=0.7
RRF_BM25_WEIGHT=0.3
# 关键词路的置信门槛：返回结果少于此数量时认为它没找到真正匹配的内容，
# 不参与融合。加这道门槛让 Recall@1 从 60% 提升到 66.7%
BM25_MIN_RESULTS=5

# ---------- 对话与查询改写 ----------
# 是否启用历史感知查询改写（把"它支持快充吗"补全成"XX手机支持快充吗"）
QUERY_REWRITE_ENABLED=true
# 送给大模型的历史对话轮数上限，控制 token 预算
HISTORY_MAX_TURNS=6

# ---------- 缓存 ----------
# 答案缓存的存活秒数
CACHE_TTL_SECONDS=3600
# 答案缓存的最大条目数
CACHE_MAX_SIZE=1000

# ---------- 限流 ----------
# 每个用户每分钟的请求上限（问答接口用更严的一半）
RATE_LIMIT_PER_MINUTE=60
# 单个用户同时进行的问答数上限
CHAT_CONCURRENCY_PER_USER=3

# ---------- 令牌有效期 ----------
# 访问令牌有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=60
# 刷新令牌有效期（天）
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- 统计 ----------
# 看板按天分组时用的时区偏移（小时）。
# 库里存的是 UTC，不做换算的话"今日问答"要等到北京时间早上 8 点才刷新，
# 而且凌晨的提问会被算到前一天
STATS_TIMEZONE_OFFSET_HOURS=8

# ---------- 跨域 ----------
# 前端开发服务器地址，多个用逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 基本不会改的几项 ----------
# 应用名称，会显示在接口文档和健康检查里
#APP_NAME=电商知识库问答系统
# 接口路径前缀
#API_V1_PREFIX=/api/v1
# JWT 签名算法，除非有特别需求否则不用改
#JWT_ALGORITHM=HS256
# 数据库连接串。**换成 PostgreSQL 只需要改这一行**，
# 代码里没有用 SQLite 专有语法，换过去不用动其他地方。例如：
#   postgresql+psycopg://用户名:密码@localhost:5432/ragdb
#DATABASE_URL=sqlite:///./data/app.db
